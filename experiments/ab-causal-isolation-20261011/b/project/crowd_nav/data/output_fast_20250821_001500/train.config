[trainer]
batch_size    = 8192           ; 极大batch size提高稳定性和效率
gamma         = 0.99           ; 保持高折扣因子
tau           = 0.02           ; 更快的目标网络更新
lr_actor      = 0.0003         ; 提高学习率加速收敛
lr_critic     = 0.0004         ; 更高的critic学习率
lr_alpha      = 0.0002         ; 提高alpha学习率
target_entropy= -1.8           ; 更多探索帮助发现最优策略
use_amp       = true
grad_clip     = 2.0            ; 允许更大梯度更新
awbc_beta     = 3.0            ; 降低BC约束，让RL更自由探索

[imitation_learning]
il_episodes       = 500         ; 大量高质量专家数据
il_policy         = orca
il_epochs         = 8000        ; 充分的BC预训练
il_learning_rate  = 0.0005     ; 更高学习率确保BC收敛
safety_space      = 0.06       ; 减小安全边距，更激进的专家演示

[train]
train_batches     = 500         ; 极大增加每轮训练步数
train_episodes    = 400         ; 大幅减少总轮数到400，6小时内完成
sample_episodes   = 24          ; 增加采样量
target_update_interval = 25     ; 更频繁更新
evaluation_interval = 25        ; 频繁评估监控
checkpoint_interval = 100       ; 适度保存
capacity          = 500000      ; 超大回放池
epsilon_start     = 0.15        ; 更多初始探索
epsilon_end       = 0.005       ; 极低最终探索
epsilon_decay     = 300         ; 快速探索衰减

; 轻量评估
val_subset        = 100         ; 增加验证集大小，更准确评估
eval_full_every   = 200         ; 更频繁全面评估
train_stat_stride = 3           ; 更频繁统计

[vectorize]
enable            = true
num_workers       = 12          ; 最大化并行采样
episodes_per_worker = 8         ; 每个worker更多采样
broadcast_interval  = 2         ; 极频繁参数同步
worker_device     = cuda:0      ; 关键：worker 前向走 GPU（mamba_ssm 需要）

[dagger]
exp_full = 0
exp_anneal = 1
min_prob = 0.0
