[env]
# -- General simulation parameters --
time_limit = 100
time_step = 0.25
val_size = 100
test_size = 300
randomize_attributes = true

[reward]
; Terminal rewards
success_reward = 50.0
collision_penalty = -20.0
timeout_penalty = 0.0

; Discomfort penalty (squared)
discomfort_dist = 0.3
discomfort_penalty_factor = 2.0

; -- Core shaping: balance progress and safety --
w_prog  = 5.0
w_goal  = 12.0
w_coll  = 4.0
w_soc   = 1.0
soc_dist= 0.4
alpha   = 5.0
v_safe  = 0.8
w_relv  = 0.4
w_time  = 0.3
w_shape = 0.0
w_align = 0.0
max_dist= 10.0

; TTC prediction
w_ttc = 1.0
ttc_thresh = 2.5

; Speed shaping (quadratic deviation from v_pref)
w_speed = 0.25
speed_target = 0.85

; Early stop: prevent stuck in place
noprog_eps = 0.03
noprog_patience = 15

[sim]
train_val_sim = circle_crossing
test_sim = circle_crossing
square_width = 10
circle_radius = 4
human_num = 5

[humans]
visible = true
policy = orca
radius = 0.3
v_pref = 1
sensor = coordinates

[robot]
visible = false
policy = none
radius = 0.3
v_pref = 1
sensor = coordinates

[orca]
; -- Aggressive ORCA expert for efficiency-first demonstrations --
neighbor_dist = 4.0
max_neighbors = 8
time_horizon = 3.0
time_horizon_obst = 2.5
radius = 0.3
max_speed = 1.2
safety_space = 0.05
label_inflate = 0.05
slow_k = 1.0
eps_noise = 0.01

; -- TTC feedforward braking (matches orca.py changes) --
ttc_brake = 1.8
brake_min_ratio = 0.4

; -- Human preferred speed mode (consistent with CrowdNav)
human_pref_mode = goal

[action_space]
kinematics = holonomic
speed_samples = 5
rotation_samples = 16
sampling = exponential
query_env = true
time_step = 0.25
