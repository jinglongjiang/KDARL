# ============================================================
# train.config - 训练超参数配置 (SSOT - Single Source of Truth)
# ============================================================
#
# 文件职责：所有训练相关的超参数（优化器、学习率、batch、探索率）
#
# 包含sections:
#   [train]             - 核心训练参数（batch_size、learning_rate、gamma、epsilon等）
#   [exploration]       - 探索策略参数（spread-aware、epsilon调度）
#   [trainer]           - 高级训练调度（动态τ、批次稳压器）
#   [buffer]            - Buffer容量与IL混合参数
#   [imitation_learning] - IL数据采集参数（ORCA teacher配置）
#
# WARNING: 环境物理参数（time_step、circle_radius等）在 env.config
# WARNING: 模型架构参数（d_model、n_layers、T等）在 policy.config
# ============================================================

[train]
# 算法选择
algo = sac                     # 使用SAC (Soft Actor-Critic)

train_episodes = 6000
eval_every = 100
eval_episodes = 50
plot_interval = 100
plot_every = 50
save_every = 500
roll_window = 50

# 训练核心参数
batch_size = 256
updates_per_ep = 4

# IL阶段：仅用于BC初始化
il_epochs = 20
il_batch_size = 512
il_learning_rate = 3e-4

# 梯度裁剪
clip_grad_norm = 0.5

# ============================================================
# SSOT: 训练超参数统一配置
# ============================================================
gamma = 0.99
learning_rate = 3e-4
bootstrap_on_timeout = False

# 奖励配置
reward_profile = benchmark

[buffer]
capacity = 800000
il_capacity = 200000
seq_len = 12
warmup_episodes = 50
batch_size = 256

# ============================================================
# 并行采样配置（4 workers，平衡速度与稳定性）
# ============================================================
[vectorize]
# 核心开关
# RTX 4090 优化：关闭并行采样，启用torch.compile JIT
# 理由：4090的JIT编译加速（Mamba SSM的细碎Kernel融合）
#       的收益 >> 多进程采样的收益
# 4090单线程+JIT > 4线程无JIT（在此场景下）
enable = false                # 关闭：4090需要torch.compile

# 并行度配置：改善数据/更新比例（从1:20→1:10）
num_workers = 4               # 4个并行worker
episodes_per_worker = 2       # 每个worker跑2个episodes（从1增加到2）
                              # 总并行度: 4×2=8 episodes/batch
                              # 配合updates_per_ep=80，比例从4:80(1:20)改善到8:80(1:10)

# Worker配置
worker_device = cuda:0        # 所有worker在GPU上（Mamba SSM必须用CUDA）
broadcast_interval = 1        # 每批次同步模型参数到workers

# 性能预期:
# - 采样时间: 30秒×16 (串行) → 8-10秒 (8倍并行)
# - Buffer增长: 16 episodes × 80 steps = 1280 samples/batch
# - GPU利用率: 15% → 75-85%
# - 显存使用: 863MB → 8-9GB (充分利用11GB空闲显存)
# - 总加速比: 90-120x
# ============================================================

[imitation_learning]
# BC训练阶段：使用ORCA teacher收集expert demonstrations
success_target = 2000             # 目标成功轨迹数量
max_prefill_episodes = 12000      # 最大采样episodes（防止无限循环）
prefill_batch_episodes = 64       # 每批采样量
max_il_prefill = 15000            # 实际加载到IL数据集的轨迹上限（15K条，充分利用50K数据集）

# ORCA teacher配置（提供conservative demonstrations）
teacher_neighbor_dist = 6.0
teacher_max_neighbors = 15
teacher_time_horizon = 4.5
teacher_time_horizon_obst = 4.5
teacher_safety_space = 0.10

# ============================================================
# [sac] SAC专用超参数
# ============================================================
[sac]
# Replay Buffer配置
replay_capacity = 200000       # Replay buffer容量（干净版SAC）
replay_warmup = 5000           # 最少transitions数才开始训练（降低门槛，配合Anchor快速启动）

# Q网络warmup：用IL数据（统一reward下）预热Q
q_warmup_steps = 1000          # Q网络warmup步数（防止从白板开始）

# Target Network
tau = 0.005                    # Polyak averaging系数（target net软更新）
target_update_freq = 1         # 每N步更新一次target net

# 学习率
q_lr = 3e-4                    # Q网络学习率
policy_lr = 1e-4               # Policy学习率（略低于Q）
alpha_lr = 3e-4                # Temperature学习率

# 熵自动调节
auto_tune_alpha = true         # 开启自动调节
init_alpha = 0.05              # 初始温度
target_entropy_ratio = 1.0

# BC regularization：防止policy偏离BC学到的行为
bc_regularization_weight = 0.05 # BC正则项权重（L_policy = L_SAC + λ*L_BC）