[env]
# —— 通用仿真参数 ——
time_limit = 100
time_step = 0.25
val_size = 100
test_size = 300
randomize_attributes = true

[reward]
; 终局项
success_reward = 30.0          ; 大幅增加成功奖励，强化目标导向
collision_penalty = -15.0      ; 严格惩罚碰撞
timeout_penalty = 0.0        ; 仅供日志用，env 内部用不到

; 近距不适（平方惩罚）
discomfort_dist = 0.25
discomfort_penalty_factor = 4.0  ; 降低不适惩罚，避免过度保守

; —— 核心 shaping：平衡进度和安全 ——
w_prog  = 3.5              ; 增加进度权重，鼓励前进
w_goal  = 8.0              ; 大幅增加目标导向权重
w_coll  = 6.0              ; 适度降低避障权重，避免过度保守
w_soc   = 1.5              ; 降低社交距离权重
soc_dist= 0.5              ; 适度社交距离
alpha   = 8.0              ; 降低alpha，减少指数惩罚强度
v_safe  = 0.6              ; 提高安全速度
w_relv  = 0.6              ; 降低相对速度权重
w_time  = 0.2              ; 增加时间奖励，鼓励快速导航
w_shape = 0.0
w_align = 0.0
max_dist= 10.0

; 预判类（TTC）
w_ttc = 1.0
ttc_thresh = 2.5

; 速度整形（相对 v_pref 的二次偏差）
w_speed = 0.15              ; 增加速度奖励
speed_target = 0.75         ; 提高目标速度

; 早停：防原地磨
noprog_eps = 0.02           ; 增加进度阈值
noprog_patience = 20        ; 减少耐心，更快结束停滞episode

[sim]
train_val_sim = circle_crossing
test_sim = circle_crossing
square_width = 10
circle_radius = 4
human_num = 5

[humans]
visible = true
policy = orca
radius = 0.3
v_pref = 1
sensor = coordinates

[robot]
visible = false
policy = none
radius = 0.3
v_pref = 1
sensor = coordinates

[orca]
; —— 平衡的 ORCA 专家设定，提供高质量演示 ——
neighbor_dist = 3.5
max_neighbors = 8
time_horizon = 3.5          ; 稍短的预测窗口，更灵活
time_horizon_obst = 3.0
radius = 0.3
max_speed = 1.2
safety_space = 0.08         ; 适度安全空间
label_inflate = 0.08        ; 减小标注膨胀
slow_k = 1.5                ; 减少过早减速
eps_noise = 0.02            ; 减小噪声

; —— TTC 前馈制动（与 orca.py 改动匹配）——
ttc_brake = 1.8             ; 更短的TTC阈值，减少过早制动
brake_min_ratio = 0.4       ; 保留更多速度

; —— 行人首选速度模式（consistent with CrowdNav）
human_pref_mode = goal

[action_space]
kinematics = holonomic
speed_samples = 5
rotation_samples = 16
sampling = exponential
query_env = true
time_step = 0.25
