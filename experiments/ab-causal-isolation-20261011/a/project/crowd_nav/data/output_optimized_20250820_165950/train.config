[trainer]
batch_size    = 4096           ; 大幅增加batch size，提高训练稳定性
gamma         = 0.99           ; 保持高折扣因子
tau           = 0.01           ; 加快目标网络更新，提高学习效率
lr_actor      = 0.00015        ; 适度提高actor学习率
lr_critic     = 0.0002         ; 提高critic学习率
lr_alpha      = 0.0001         ; 适度提高alpha学习率
target_entropy= -2.0           ; 保持适度探索
use_amp       = true
grad_clip     = 1.0            ; 放宽梯度裁剪，允许更大更新
awbc_beta     = 5.0            ; 适度降低BC正则化，平衡IL和RL

[imitation_learning]
il_episodes       = 300         ; 大幅增加专家数据量，提供更多高质量演示
il_policy         = orca
il_epochs         = 5000        ; 增加预训练轮数，充分学习ORCA策略
il_learning_rate  = 0.0003     ; 提高IL学习率，加快BC预训练
safety_space      = 0.08       ; 与ORCA配置保持一致

[train]
train_batches     = 300         ; 大幅增加每轮训练步数，充分利用数据
train_episodes    = 800         ; 减少总轮数，提高训练效率
sample_episodes   = 16          ; 增加采样episodes
target_update_interval = 50     ; 兼容项（未用）
evaluation_interval = 50        ; 更频繁评估，及时监控进度
checkpoint_interval = 200       ; 更频繁保存
capacity          = 300000      ; 增大RL回放缓冲区
epsilon_start     = 0.1         ; 稍微增加初始探索
epsilon_end       = 0.01        ; 降低最终探索率
epsilon_decay     = 1000        ; 加快探索衰减

; 轻量评估
val_subset        = 100         ; 增加验证集大小，更准确评估
eval_full_every   = 200         ; 更频繁全面评估
train_stat_stride = 3           ; 更频繁统计

[vectorize]
enable            = true
num_workers       = 8           ; 增加并行工作进程，大幅提速采样
episodes_per_worker = 6         ; 增加每个worker采样量
broadcast_interval  = 3         ; 更频繁同步模型参数
worker_device     = cuda:0      ; 关键：worker 前向走 GPU（mamba_ssm 需要）

[dagger]
exp_full = 0
exp_anneal = 1
min_prob = 0.0
