[trainer]
batch_size    = 8192
gamma         = 0.99
tau           = 0.02
lr_actor      = 0.0003
lr_critic     = 0.0004
lr_alpha      = 0.0002
target_entropy= -1.8
use_amp       = true
grad_clip     = 2.0
awbc_beta     = 3.0

[imitation_learning]
il_episodes       = 500
il_policy         = orca
il_epochs         = 8000
il_learning_rate  = 0.0005
safety_space      = 0.06

[train]
train_batches     = 500
train_episodes    = 400
sample_episodes   = 24
target_update_interval = 25
evaluation_interval = 25
checkpoint_interval = 100
capacity          = 500000
epsilon_start     = 0.15
epsilon_end       = 0.005
epsilon_decay     = 300

; Lightweight evaluation
val_subset        = 100
eval_full_every   = 200
train_stat_stride = 3

[vectorize]
enable            = true
num_workers       = 12
episodes_per_worker = 8
broadcast_interval  = 2
worker_device     = cuda:0

[dagger]
exp_full = 0
exp_anneal = 1
min_prob = 0.0
