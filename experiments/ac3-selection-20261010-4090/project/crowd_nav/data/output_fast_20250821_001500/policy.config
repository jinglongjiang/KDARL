[mamba]
# -- Structure capacity (strictly corresponds to env obs dimensions) --
use_amp = true
try_compile = true

obs_dim        = 34
state_dim      = 34
robot_feat_dim = 9
human_feat_dim = 5
human_num      = 5

hidden_dim     = 256
n_blocks       = 6
conv_dim       = 4
expand         = 2
dropout        = 0.01
topk           = 5

gamma          = 0.99
action_scale   = 1.0
multiagent_training = true
env_stochastic = true

; Compatible fields (not directly used by new trainer, but kept for compatibility)
learning_rate  = 0.0002

[action_space]
kinematics = holonomic

; Expert (ORCA policy for IL also reads from this policy.config)
[orca]
neighbor_dist = 4.0
max_neighbors = 8
time_horizon = 3.0
time_horizon_obst = 2.5
radius = 0.3
max_speed = 1.2
safety_space = 0.05
ttc_brake = 1.5
brake_min_ratio = 0.5
label_inflate = 0.05
slow_k = 1.0
eps_noise = 0.01
