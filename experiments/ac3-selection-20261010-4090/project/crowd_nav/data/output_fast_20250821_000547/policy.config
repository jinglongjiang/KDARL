[mamba]
# —— 结构容量（与 env 的 obs 维度严格对应）——
use_amp = true
try_compile = true

obs_dim        = 34
state_dim      = 34
robot_feat_dim = 9
human_feat_dim = 5
human_num      = 5

hidden_dim     = 256           ; 超大隐藏层，极强模型容量
n_blocks       = 6             ; 更多Mamba块，强化序列建模
conv_dim       = 4
expand         = 2
dropout        = 0.01          ; 最小dropout，保留所有信息
topk           = 5             ; 必须编码所有5个行人，否则会丢失信息！

gamma          = 0.99          ; 提高折扣因子，更重视长期奖励
action_scale   = 1.0
multiagent_training = true
env_stochastic = true          ; 训练期策略用随机采样（SAC），评估期自动用确定性

; 兼容字段（不会被新训练器直接用，但保留不冲突）
learning_rate  = 0.0002        ; 降低学习率，更稳定训练

[action_space]
kinematics = holonomic

; Expert（用于 IL 的 ORCA 策略也从此 policy.config 读取）
[orca]
neighbor_dist = 4.0
max_neighbors = 8
time_horizon = 3.0
time_horizon_obst = 2.5
radius = 0.3
max_speed = 1.2
safety_space = 0.05
ttc_brake = 1.5
brake_min_ratio = 0.5
label_inflate = 0.05
slow_k = 1.0
eps_noise = 0.01
