[env]
# —— 通用仿真参数 ——
time_limit = 100
time_step = 0.25
val_size = 100
test_size = 300
randomize_attributes = true

[reward]
; 终局项
success_reward = 50.0          ; 极大成功奖励，强烈激励到达目标
collision_penalty = -20.0      ; 更严厉的碰撞惩罚
timeout_penalty = 0.0        ; 仅供日志用，env 内部用不到

; 近距不适（平方惩罚）
discomfort_dist = 0.3          ; 增大不适距离
discomfort_penalty_factor = 2.0  ; 大幅降低不适惩罚

; —— 核心 shaping：平衡进度和安全 ——
w_prog  = 5.0              ; 极大增加进度权重
w_goal  = 12.0             ; 极强目标导向
w_coll  = 4.0              ; 降低避障权重，鼓励穿过人群
w_soc   = 1.0              ; 最小化社交距离约束
soc_dist= 0.4              ; 减小社交距离
alpha   = 5.0              ; 大幅降低惩罚强度
v_safe  = 0.8              ; 提高安全速度
w_relv  = 0.4              ; 减少相对速度考虑
w_time  = 0.3              ; 更强时间奖励
w_shape = 0.0
w_align = 0.0
max_dist= 10.0

; 预判类（TTC）
w_ttc = 1.0
ttc_thresh = 2.5

; 速度整形（相对 v_pref 的二次偏差）
w_speed = 0.25              ; 强速度奖励
speed_target = 0.85         ; 接近最大速度

; 早停：防原地磨
noprog_eps = 0.03           ; 更大进度阈值
noprog_patience = 15        ; 更快结束停滞

[sim]
train_val_sim = circle_crossing
test_sim = circle_crossing
square_width = 10
circle_radius = 4
human_num = 5

[humans]
visible = true
policy = orca
radius = 0.3
v_pref = 1
sensor = coordinates

[robot]
visible = false
policy = none
radius = 0.3
v_pref = 1
sensor = coordinates

[orca]
; —— 激进的 ORCA 专家，提供效率优先的演示 ——
neighbor_dist = 4.0         ; 更大感知范围
max_neighbors = 8
time_horizon = 3.0          ; 更短预测，更快决策
time_horizon_obst = 2.5
radius = 0.3
max_speed = 1.2
safety_space = 0.05         ; 最小安全空间
label_inflate = 0.05        ; 最小标注膨胀
slow_k = 1.0                ; 最小减速
eps_noise = 0.01            ; 最小噪声

; —— TTC 前馈制动（与 orca.py 改动匹配）——
ttc_brake = 1.8             ; 更短的TTC阈值，减少过早制动
brake_min_ratio = 0.4       ; 保留更多速度

; —— 行人首选速度模式（consistent with CrowdNav）
human_pref_mode = goal

[action_space]
kinematics = holonomic
speed_samples = 5
rotation_samples = 16
sampling = exponential
query_env = true
time_step = 0.25
