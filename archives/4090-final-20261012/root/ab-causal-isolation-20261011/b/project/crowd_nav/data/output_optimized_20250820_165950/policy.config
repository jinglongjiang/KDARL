[mamba]
# —— 结构容量（与 env 的 obs 维度严格对应）——
use_amp = true
try_compile = true

obs_dim        = 34
state_dim      = 34
robot_feat_dim = 9
human_feat_dim = 5
human_num      = 5

hidden_dim     = 128           ; 大幅增加隐藏层维度，提升Mamba模型容量
n_blocks       = 4             ; 增加Mamba块数，增强序列建模能力
conv_dim       = 4
expand         = 2
dropout        = 0.05          ; 进一步降低dropout，减少信息损失
topk           = 5             ; 必须编码所有5个行人，否则会丢失信息！

gamma          = 0.99          ; 提高折扣因子，更重视长期奖励
action_scale   = 1.0
multiagent_training = true
env_stochastic = true          ; 训练期策略用随机采样（SAC），评估期自动用确定性

; 兼容字段（不会被新训练器直接用，但保留不冲突）
learning_rate  = 0.0002        ; 降低学习率，更稳定训练

[action_space]
kinematics = holonomic

; Expert（用于 IL 的 ORCA 策略也从此 policy.config 读取）
[orca]
neighbor_dist = 3.5
max_neighbors = 8
time_horizon = 3.5
time_horizon_obst = 3.0
radius = 0.3
max_speed = 1.2
safety_space = 0.08
ttc_brake = 1.8
brake_min_ratio = 0.4
label_inflate = 0.08
slow_k = 1.5
eps_noise = 0.02
