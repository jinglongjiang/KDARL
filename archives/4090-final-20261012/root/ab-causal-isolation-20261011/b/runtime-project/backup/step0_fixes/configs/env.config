# ============================================================
# env.config - 环境与仿真配置 (SSOT - Single Source of Truth)
# ============================================================
#
# 文件职责：环境物理参数、场景配置、奖励函数、ORCA参数
#
# 包含sections:
#   [env]     - 环境基础参数（时间步长、时限、场景尺寸）
#   [reward]  - 奖励函数配置（成功/碰撞/超时奖励）
#   [sim]     - 仿真场景配置（形状、尺寸、人数）
#   [robot]   - 机器人物理参数（半径、速度、可见性）
#   [humans]  - 人类物理参数（半径、速度、策略）
#   [orca]    - ORCA算法参数（感知范围、时间视野）
#   [policy]  - 动作空间配置（速度档位、方向离散化）
#   [buffer]  - 采样策略参数（批次组成、尾窗策略）
#
# WARNING: 训练超参数（batch_size、learning_rate等）在 train.config
# WARNING: 模型架构参数（d_model、n_layers等）在 policy.config
# ============================================================

[env]
# 论文对标：恢复25秒（100步@0.25s）
time_limit = 25
time_step = 0.25
val_size = 100
test_size = 500
randomize_attributes = true

# 评估口径写死：R=4, Nh=5, dt=0.25, T=25, success_radius=0.25, robot.visible=false
circle_radius = 4.0
human_num = 5
success_radius = 0.25

[reward]
# ============================================================
# Step 4 (todo.md): 简化奖励函数，回归基础版本
# 先稳住SAC的学习，后续再细化
# ============================================================
success_reward = 10.0
collision_penalty = -10.0
timeout_penalty = -10.0

# 只保留progress作为前进奖励
w_goal = 0.0
w_prog = 1.0
w_ttc = 0.0
w_time = 0.0
stand_penalty = 0.0
potential = 0.0

# 其他参数保留（兼容性）
discomfort_dist = 0.2
discomfort_penalty_factor = 0.0
success_radius = 0.25
w_coll = 0.0
w_soc = 0.0
w_potential = 0.0
w_shape = 0.0
w_align = 0.0
w_relv = 0.0
w_speed = 0.0
soc_dist = 0.5
alpha = 10.0
v_safe = 0.5
max_dist = 10.0
ttc_thresh = 2.0
speed_target = 0.6
noprog_eps = 0.02
noprog_patience = 20
progress_weight = 0.0
time_penalty = -0.05
min_clearance_for_progress = 0.0


[sim]
train_val_sim = circle_crossing
test_sim = circle_crossing
square_width = 10
circle_radius = 4
human_num = 5

[humans]
visible = true
policy = orca
radius = 0.3
v_pref = 1
sensor = coordinates

[robot]
visible = false
policy = none
radius = 0.3
v_pref = 1.0
sensor = coordinates
success_radius = 0.25

# ORCA配置 - 纯ORCA方案A+C优化（回归理论 + 参数优化）
[orca]
# 扩大感知范围（原3.0 → 4.5）
neighbor_dist = 4.5
# 增加邻居数（原10 → 12）
max_neighbors = 12
# 延长规划时间（原3.0 → 5.0）
time_horizon = 5.0
time_horizon_obst = 3.0
# 降低安全边界（原0.20 → 0.10）
safety_space = 0.20           # 进一步增加缓冲 (0.15 -> 0.20)，老师示范更从容

[policy]
name = mamba
# 修正：禁止绝对静止 (v_min=0.1)，逼迫Agent必须做出移动决策
n_speeds = 5
n_headings = 16
v_min = 0.1
v_max = 1.0
sampling = even

# action space configuration
[action_space]
kinematics = holonomic
# dt = time_step (将从time_step继承)

# ============================================================
# SSOT清理：[train]和[trainer] section已移至train.config
# env.config只保留环境、仿真、物理相关配置
# ============================================================

# ============================================================
# SSOT: [mamba] 配置已移至 policy.config，此处不再重复定义
# ============================================================