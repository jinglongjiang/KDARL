# ============================================================
# train.config - 训练配置
# ============================================================

[train]
algo = sarl
train_episodes = 1500
eval_every = 1000
eval_episodes = 50
save_every = 500

# 核心超参数
batch_size = 256
learning_rate = 1e-5
gamma = 0.99
updates_per_ep = 4

# IL阶段
il_epochs = 50
il_batch_size = 256
il_learning_rate = 1e-4

# Replay warmup
replay_warmup = 5000

[buffer]
capacity = 200000
seq_len = 24

[imitation_learning]
max_prefill_episodes = 1500
success_target = 600
max_il_prefill = 50000
# SARL "降维打击"：IL用保守专家(0.25)，RL用宽松环境(0.10)
teacher_safety_space = 0.25
teacher_neighbor_dist = 6.0
teacher_max_neighbors = 15
teacher_time_horizon = 5.0
teacher_time_horizon_obst = 5.0

[sarl]
epsilon_start = 0.3
epsilon_end = 0.05
epsilon_decay_episodes = 1500
value_lr = 1e-5
